# 1. Base Image (Verified for Thor)
FROM ubuntu:24.04

# 2. Environment (CUDA 13)
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
ENV USE_GPU=true
ENV DEVICE="cuda"

# 3. System Dependencies (Kokoro needs espeak-ng)
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    git \
    libsndfile1 \
    ffmpeg \
    curl \
    build-essential \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

# Fix PEP 668
RUN rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED

# 4. Install PyTorch (cu130 for Thor)
RUN pip3 install --no-cache-dir \
    torch \
    torchvision \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cu130

# 5. Kokoro Source & Dependencies
WORKDIR /app

# Clone repo at build time (Fall-back support without submodule)
RUN git clone https://github.com/remsky/Kokoro-FastAPI /app

# Install Python Deps (Manual list to avoid Torch conflict)
RUN pip3 install --no-cache-dir \
    fastapi \
    uvicorn \
    click \
    pydantic \
    pydantic-settings \
    python-dotenv \
    sqlalchemy \
    numpy \
    scipy \
    soundfile \
    regex \
    aiofiles \
    tqdm \
    requests \
    munch \
    tiktoken \
    loguru \
    openai \
    pydub \
    matplotlib \
    mutagen \
    psutil \
    espeakng-loader \
    misaki[en] \
    spacy \
    inflect \
    phonemizer-fork \
    hf_transfer \
    av \
    text2num \
    text2num \
    huggingface_hub

# Download Kokoro Model
RUN python3 docker/scripts/download_model.py --output api/src/models/v1_0

# Install kokoro (library)
RUN pip3 install --no-cache-dir kokoro>=0.6.0

# Install spacy model
RUN python3 -m spacy download en_core_web_sm

# 6. Setup Entrypoint
# The wrapper usually runs `uvicorn api.src.main:app` or similar.
# Checking docker/gpu/Dockerfile: `CMD ["./entrypoint.sh"]`.
# Checking `entrypoint.sh` content? I don't have it.
# I'll check `pyproject.toml` entrypoint or just guess `uvicorn`.
# `Dockerfile` sets `PYTHONPATH=/app:/app/api`.
ENV PYTHONPATH=/app:/app/api

# 7. Runtime
EXPOSE 8880
CMD ["uvicorn", "api.src.main:app", "--host", "0.0.0.0", "--port", "8880"]
