# Base Image: DeepStream 8.0 for Jetson/dGPU (Multiarch)
FROM nvcr.io/nvidia/deepstream:8.0-triton-multiarch

# 1. Install System Dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    libglib2.0-dev \
    libgstrtspserver-1.0-dev \
    python3-dev \
    python3-pip \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    gir1.2-gst-rtsp-server-1.0 \
    python3-gi-cairo \
    kmod \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Python Dependencies
# - ultralytics: for model export (PT -> ONNX)
# - redis: for event publishing
# - pyds: Python bindings for DeepStream (usually included or via wheel, but we rely on base image having python3-pyds or installing it)
# Note: DeepStream images often align pip with system packages
# We will skip upgrading pip to avoid conflict with apt-managed version
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/*
RUN pip3 install ultralytics redis onnx onnxslim onnxscript
RUN pip3 install --pre --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/ort-cuda-13-nightly/pypi/simple/ onnxruntime-gpu==1.25.0.dev20260331005
RUN wget https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.2/pyds-1.2.2-cp312-cp312-linux_aarch64.whl && \
    pip3 install pyds-1.2.2-cp312-cp312-linux_aarch64.whl && \
    rm pyds-1.2.2-cp312-cp312-linux_aarch64.whl

# 3. Setup DeepStream-Yolo (Custom BBox Parser)
WORKDIR /opt/nvidia/deepstream/deepstream/sources
RUN git clone https://github.com/marcoslucianops/DeepStream-Yolo.git
WORKDIR /opt/nvidia/deepstream/deepstream/sources/DeepStream-Yolo

# Compile the parser
# Target CUDA 13.0 (Thor/Blackwell) or generic
ENV CUDA_VER=13.0
RUN make -C nvdsinfer_custom_impl_Yolo clean && \
    make -C nvdsinfer_custom_impl_Yolo

# 4. App Setup
WORKDIR /app

# Copy App Logic & Configs
COPY src/vision/watchstander_ds.py .
COPY src/vision/config_infer_primary.txt .
COPY src/vision/export_model.py .
COPY src/vision/labels.txt .

# Entrypoint script to handle export and run
COPY src/vision/entrypoint.sh .
RUN chmod +x entrypoint.sh

# Default Command
CMD ["./entrypoint.sh"]
